TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token
TELEGRAM_SETUP_KEY=replace-with-a-random-secret
# Необязательно: укажите числовой chat_id заранее.
# TELEGRAM_ADMIN_CHAT_ID=123456789
PORT=8000
CODEX_MODEL=gpt-5.6-luna
# При необходимости укажите полный путь к более новой версии Codex CLI.
CODEX_BIN=codex
SUMMARY_TIMEZONE=Europe/Moscow
CODEX_TIMEOUT_SECONDS=120
